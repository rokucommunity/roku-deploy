{
    /* Visit https://github.com/rokucommunity/roku-deploy#readme to read more about this file */
    /* One flat list of values. Each comment names the commands that read it. CLI args override this file. */
    /* Relative paths resolve against the folder containing this file. Comments and trailing commas are allowed. */

    /* Device ------------------------------------------------------------------------------------------ */
    "device": { "host": "" },                                               /* all device commands. The target Roku: { "host": "192.168.1.101" }, or for a Cloud Emulator { "esn": "..." }, { "id": 123 } or { "instanceUrl": "..." } */
    "password": "",                                                         /* sideload, package, rekey, squash, deleteDevChannel, screenshot. The developer-portal password */
    // "username": "rokudev",                                               /* same commands as password. Roku only supports "rokudev" */
    // "packagePort": 80,                                                   /* sideload, package, rekey, squash, deleteDevChannel, screenshot. The developer web server port. Default 80 */
    // "ecpPort": 8060,                                                     /* keyPress, keyUp, keyDown, sendText, remote-control, sideload (close). External Control Protocol port. Default 8060 */
    // "timeout": 150000,                                                   /* all device commands. Per-request network timeout in milliseconds. Default 150000 */
    // "rceToken": "",                                                      /* all device commands targeting a Cloud Emulator, rce start, rce stop. Bearer token for the RCE api */

    /* Project ----------------------------------------------------------------------------------------- */
    "rootDir": "./",                                                        /* stage, sideload --stage, package --sideload. Folder holding your source; the manifest lives directly under it */
    "files": [                                                              /* stage, sideload --stage, package --sideload. Globs relative to rootDir, or { "src", "dest" } objects. NOT used by zip, which takes its own --files */
        "source/**/*.*",
        "components/**/*.*",
        "images/**/*.*",
        "locale/**/*",
        "fonts/**/*",
        "manifest",
        "!node_modules",
        "!**/*.{md,DS_Store,db}"
    ],
    // "stagingDir": "./out/.roku-deploy-staging",                          /* stage, sideload --stage, package --sideload. Where the filtered copy of rootDir is written before zipping */
    // "outDir": "./out",                                                   /* zip, package, screenshot. Folder that receives generated files */
    // "outFile": "roku-deploy",                                            /* zip, package. Base name of generated files: zip writes <outDir>/<outFile>.zip, package writes <outDir>/<outFile>.pkg */

    /* Sideload ---------------------------------------------------------------------------------------- */
    // "stage": false,                                                      /* sideload, package --sideload. Stage rootDir with "files" first, then zip and install. Default false: install the zip at <outDir>/<outFile>.zip */
    // "appType": "channel",                                                /* sideload. "channel" for apps (default), "dcl" for component libraries */
    // "close": true,                                                       /* sideload. Close the running channel before installing. Default true */
    // "deleteDevChannel": true,                                            /* sideload. Remove the existing dev channel before installing. Default true */
    // "failOnCompileError": true,                                          /* sideload. Fail when the device reports a compile error. Default true */
    // "remoteDebug": false,                                                /* sideload. Ask the device to start the remote debugger when the app launches */
    // "remoteDebugConnectEarly": false,                                    /* sideload. Connect the debugger before the app starts */

    /* Package ----------------------------------------------------------------------------------------- */
    // "signingPassword": "",                                               /* package, rekey. The signing password of the key on the device */
    // "devId": "",                                                         /* package, rekey. Fail if the device's dev id differs from this */
    // "appTitle": "",                                                      /* package. Title recorded in the package. Default: from the manifest */
    // "appVersion": "",                                                    /* package. Version recorded in the package. Default: from the manifest */
    // "manifestPath": "",                                                  /* package. Manifest to read the title and version from. Default: <rootDir>/manifest */
    // "squash": false,                                                     /* package. Convert the installed channel to squashfs before packaging. Default false */

    /* Rekey ------------------------------------------------------------------------------------------- */
    // "rekeySignedPackage": "",                                            /* rekey, package --rekey. A previously signed .pkg whose key should be installed on the device; signed with signingPassword */

    /* Screenshot -------------------------------------------------------------------------------------- */
    // "screenshotDir": "",                                                 /* screenshot. Folder used when no --out is given. Default: outDir */

    /* Cloud Emulator ---------------------------------------------------------------------------------- */
    // "snapshot": "live",                                                  /* rce start. Snapshot to boot from, by name. "live" selects the live snapshot */
    // "firmwareVersionId": "",                                             /* rce start. The firmware to boot with. Default: the snapshot's, then the device's */
    // "maxRuntime": 3600,                                                  /* rce start. Maximum runtime for the instance, in seconds */

    /* General ----------------------------------------------------------------------------------------- */
    // "logLevel": "log",                                                   /* all commands. "off", "error", "warn", "log", "info", "debug" or "trace" */
}
